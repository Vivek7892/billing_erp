# ============================================================
# DJANGO
# ============================================================

SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,app.dreamwithtech.dev,share.dreamwithtech.dev,api.dreamwithtech.dev,.dreamwithtech.dev,.onrender.com

# ============================================================
# DATABASE
# ============================================================
# Option 1: SQLite (local dev only)
# USE_SQLITE=true

# Option 2: Local PostgreSQL
# USE_SQLITE=false
# USE_LOCAL_PG=true
# LOCAL_DB_NAME=billing_pos
# LOCAL_DB_USER=postgres
# LOCAL_DB_PASSWORD=your_password
# LOCAL_DB_HOST=localhost
# LOCAL_DB_PORT=5432

# Option 3: Supabase / Remote PostgreSQL / Render PostgreSQL (production)
USE_SQLITE=false
USE_LOCAL_PG=false
DATABASE_URL=postgresql://user:password@host:5432/dbname


# ============================================================
# CORS / CSRF / FRONTEND / SHARE DOMAINS
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.dreamwithtech.dev,https://share.dreamwithtech.dev
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.dreamwithtech.dev,https://share.dreamwithtech.dev

# Main Frontend ERP Application URL:
# Local:      http://localhost:3000
# Production: https://app.dreamwithtech.dev
FRONTEND_URL=https://app.dreamwithtech.dev

# Dedicated Public Bill Share Link Domain:
# Local:      http://localhost:3000
# Production: https://share.dreamwithtech.dev
PUBLIC_SHARE_URL=https://share.dreamwithtech.dev

# Backend API Public URL:
# Production: https://billing-system-api.onrender.com (or custom https://api.dreamwithtech.dev)
BACKEND_URL=https://billing-system-api.onrender.com


# ============================================================
# SECURITY (Production SSL)
# ============================================================

SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000


# ============================================================
# SUPABASE STORAGE (optional — for shop logo uploads)
# ============================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_SHOP_LOGO_BUCKET=billing_shop_logo


# ============================================================
# TWILIO (optional — for SMS/WhatsApp reminders)
# ============================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=


# ============================================================
# EMAIL CONFIGURATION (OTP, Password Reset, Notifications)
# ============================================================
#
# Production (Render / Cloud platforms):
# Render free tier and cloud hosts block outbound SMTP (ports 25, 465, 587).
# Use an HTTPS transactional email provider (port 443):
#
# Option A: Resend (Recommended, 3,000 free emails/mo)
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=re_your_api_key_here
#   DEFAULT_FROM_EMAIL=Dreamwithtech <onboarding@resend.dev>  # Or your verified domain
#
# Option B: Brevo (Sendinblue, 300 free emails/day, allows verified Gmail addresses)
#   EMAIL_PROVIDER=brevo
#   BREVO_API_KEY=xkeysib-your_api_key_here
#   DEFAULT_FROM_EMAIL=Dreamwithtech <your-verified-email@gmail.com>
#
# Option C: SendGrid (100 free emails/day)
#   EMAIL_PROVIDER=sendgrid
#   SENDGRID_API_KEY=SG.your_api_key_here
#   DEFAULT_FROM_EMAIL=Dreamwithtech <your-verified-sender@example.com>
#
# Local Development (Direct SMTP):
#   EMAIL_PROVIDER=smtp
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your_email@gmail.com
#   EMAIL_HOST_PASSWORD=your_google_app_password
#   DEFAULT_FROM_EMAIL="Dreamwithtech Billing ERP" <your_email@gmail.com>
#
EMAIL_PROVIDER=auto
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL="Dreamwithtech Billing ERP" <dreamwithtech.dev@gmail.com>
REGISTRATION_NOTIFICATION_EMAIL=connectwithvvivek@gmail.com


# ============================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================
#
# Register at: https://dashboard.razorpay.com/
# Documentation: https://razorpay.com/docs/payments/payment-gateway/
#
# ── Test Mode ────────────────────────────────────────────────
# Use test keys from Razorpay Dashboard > Settings > API Keys
#
#   RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
#   RAZORPAY_KEY_SECRET=your_test_secret
#
# ── Live Mode ────────────────────────────────────────────────
#   RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
#   RAZORPAY_KEY_SECRET=your_live_secret
#
# IMPORTANT:
#   - NEVER commit real credentials to version control.
#   - Set RAZORPAY_WEBHOOK_SECRET from Dashboard > Webhooks
# ─────────────────────────────────────────────────────────────

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Webhook URL to register in Razorpay Dashboard:
# https://billing-system-api.onrender.com/api/payments/razorpay/webhook/
