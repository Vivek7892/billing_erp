# ============================================================
# DJANGO
# ============================================================

SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1


# ============================================================
# DATABASE
# ============================================================
# Option 1: SQLite (local dev only)
USE_SQLITE=true

# Option 2: Local PostgreSQL
# USE_SQLITE=false
# USE_LOCAL_PG=true
# LOCAL_DB_NAME=billing_pos
# LOCAL_DB_USER=postgres
# LOCAL_DB_PASSWORD=your_password
# LOCAL_DB_HOST=localhost
# LOCAL_DB_PORT=5432

# Option 3: Supabase / Remote PostgreSQL (production)
# USE_SQLITE=false
# USE_LOCAL_PG=false
# DATABASE_URL=postgresql://user:password@host:5432/dbname


# ============================================================
# CORS / CSRF / FRONTEND
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Must be the public URL of your frontend.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000


# ============================================================
# SECURITY
# ============================================================

SECURE_HSTS_SECONDS=0


# ============================================================
# SUPABASE STORAGE (optional — for shop logo uploads)
# ============================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_SHOP_LOGO_BUCKET=shop-logos


# ============================================================
# TWILIO (optional — for SMS/WhatsApp reminders)
# ============================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=


# ============================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================
#
# Register at: https://dashboard.razorpay.com/
# Documentation: https://razorpay.com/docs/payments/payment-gateway/
#
# ── Test Mode ────────────────────────────────────────────────
# Use test keys from Razorpay Dashboard > Settings > API Keys
#
#   RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
#   RAZORPAY_KEY_SECRET=your_test_secret
#
# ── Live Mode ────────────────────────────────────────────────
#   RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
#   RAZORPAY_KEY_SECRET=your_live_secret
#
# IMPORTANT:
#   - NEVER commit real credentials to version control.
#   - Set RAZORPAY_WEBHOOK_SECRET from Dashboard > Webhooks
# ─────────────────────────────────────────────────────────────

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Webhook URL to register in Razorpay Dashboard:
# https://your-backend.com/api/payments/razorpay/webhook/
